{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "warn",
    "eqeqeq": "error"
  },
  "ignorePatterns": ["prebuild-src/", "out/", "dist/", "src/assets/vendor/", "src/assets/misc/file-icons-match.js"]
}
